# syntax=docker/dockerfile:1
# Lambda serving image for the credit-risk model.
#   docker build -f Dockerfile.serve -t credit-default-api .
FROM public.ecr.aws/lambda/python:3.12

# Install serving dependencies into the Lambda task root.
COPY requirements-serve.txt .
RUN pip install --no-cache-dir -r requirements-serve.txt

# Copy source, model, and app into the Lambda task root.
COPY src/ ${LAMBDA_TASK_ROOT}/src/
COPY models/best_model.joblib ${LAMBDA_TASK_ROOT}/models/best_model.joblib
COPY app.py ${LAMBDA_TASK_ROOT}/

# Make the credit_risk package importable when unpickling the model.
ENV PYTHONPATH=${LAMBDA_TASK_ROOT}/src

# Lambda invokes this handler: <file>.<function> -> app.handler (the Mangum wrapper).
CMD ["app.handler"]
